<form class="{{cssClass}} sgrpg flexcol itemsheet origin-sheet" autocomplete="off">
    {{!-- Sheet Header --}}
    <header class="sheet-header">
        <div class="header-fields">
            <h1 class="charname flexrow">
                <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="70" width="70"/>
                <input name="name" type="text" value="{{item.name}}" placeholder="Origin Name"/>
            </h1>
        </div>
    </header>

    <section class="sheet-body flexcol">
        <div class="origin-config-wrapper">
            {{!-- BASIC INFO --}}
            <div class="origin-section">
                <div class="section-title">BASIC INFO</div>
                <div class="section-content">
                    <div class="origin-stat-row">
                        <div class="origin-stat">
                            <label for="system.originType">Origin Type</label>
                            <select name="system.originType" data-dtype="String">
                                {{selectOptions config.originTypes selected=data.originType localize=false}}
                            </select>
                        </div>
                        <div class="origin-stat">
                            <label for="system.requirements">Requirements</label>
                            <input name="system.requirements" type="text" value="{{data.requirements}}" placeholder="e.g., Must be a Jaffa"/>
                        </div>
                    </div>
                    <div class="origin-stat-row">
                        <div class="origin-stat">
                            <label for="system.castTime.value">Cast Time</label>
                            <div class="flexrow" style="gap: 5px;">
                                <input name="system.castTime.value" type="text" value="{{data.castTime.value}}" placeholder="Value" style="flex: 1;"/>
                                <select name="system.castTime.type" data-dtype="String" style="flex: 1;">
                                    <option value="" {{#unless data.castTime.type}}selected{{/unless}}>-</option>
                                    <option value="action" {{#if (eq data.castTime.type "action")}}selected{{/if}}>Action</option>
                                    <option value="bonus" {{#if (eq data.castTime.type "bonus")}}selected{{/if}}>Bonus Action</option>
                                    <option value="reaction" {{#if (eq data.castTime.type "reaction")}}selected{{/if}}>Reaction</option>
                                    <option value="turn" {{#if (eq data.castTime.type "turn")}}selected{{/if}}>Turn</option>
                                </select>
                            </div>
                        </div>
                        <div class="origin-stat">
                            <label for="system.limitations.value">Limitations</label>
                            <div class="flexrow" style="gap: 5px;">
                                <input name="system.limitations.value" type="text" value="{{data.limitations.value}}" placeholder="Value" style="flex: 1;"/>
                                <select name="system.limitations.type" data-dtype="String" style="flex: 1;">
                                    <option value="" {{#unless data.limitations.type}}selected{{/unless}}>-</option>
                                    <option value="short" {{#if (eq data.limitations.type "short")}}selected{{/if}}>Short Rest</option>
                                    <option value="long" {{#if (eq data.limitations.type "long")}}selected{{/if}}>Long Rest</option>
                                    <option value="shortlong" {{#if (eq data.limitations.type "shortlong")}}selected{{/if}}>Short/Long Rest</option>
                                    <option value="mission" {{#if (eq data.limitations.type "mission")}}selected{{/if}}>Mission</option>
                                    <option value="encounter" {{#if (eq data.limitations.type "encounter")}}selected{{/if}}>Encounter</option>
                                    <option value="day" {{#if (eq data.limitations.type "day")}}selected{{/if}}>Day</option>
                                    <option value="other" {{#if (eq data.limitations.type "other")}}selected{{/if}}>Other</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {{!-- BONUS --}}
            <div class="origin-section">
                <div class="section-title">BONUS</div>
                <div class="section-content">
                    <div class="origin-stat-row">
                        <div class="origin-stat origin-stat-full">
                            <label for="system.attributeBonus">Attribute Bonus</label>
                            <select name="system.attributeBonus" data-dtype="String">
                                {{selectOptions config.attributeBonuses selected=data.attributeBonus localize=false}}
                            </select>
                        </div>
                    </div>
                    <div class="origin-stat-row" style="margin-top: 12px;">
                        <div class="origin-stat origin-stat-full">
                            <label for="system.bonus">Perk</label>
                            <textarea name="system.bonus" rows="4" placeholder="Short summary of what this origin gives you...">{{data.bonus}}</textarea>
                        </div>
                    </div>
                </div>
            </div>

            {{!-- PROFICIENCIES --}}
            <div class="origin-section">
                <div class="section-title">PROFICIENCIES</div>
                <div class="section-content">
                    <div class="origin-stat-row">
                        <div class="origin-stat">
                            <label for="system.proficiencies.skill">Skill Proficiency</label>
                            <select name="system.proficiencies.skill" data-dtype="String">
                                <option value="none">None</option>
                                {{#each config.skills}}
                                    <option value="{{@key}}" {{#if (eq @key ../data.proficiencies.skill)}}selected{{/if}}>{{this}}</option>
                                {{/each}}
                            </select>
                        </div>
                        <div class="origin-stat">
                            <label for="system.proficiencies.weapon">Weapon Proficiency</label>
                            <select name="system.proficiencies.weapon" data-dtype="String">
                                {{selectOptions config.weaponProficiencies selected=data.proficiencies.weapon localize=false}}
                            </select>
                        </div>
                    </div>
                    <div class="origin-stat-row">
                        <div class="origin-stat">
                            <label for="system.proficiencies.armor">Armor Proficiency</label>
                            <select name="system.proficiencies.armor" data-dtype="String">
                                {{selectOptions config.armorProficiencies selected=data.proficiencies.armor localize=false}}
                            </select>
                        </div>
                        <div class="origin-stat">
                            <label for="system.proficiencies.tool">Tool Proficiency</label>
                            <select name="system.proficiencies.tool" data-dtype="String">
                                {{selectOptions config.toolProficiencies selected=data.proficiencies.tool localize=false}}
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            {{!-- DESCRIPTION --}}
            <div class="origin-section">
                <div class="section-title">DESCRIPTION</div>
                <div class="section-content">
                    <div class="origin-stat origin-stat-full">
                        {{editor data.description.value target="system.description.value" button=true owner=owner editable=editable}}
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
