<form class="{{cssClass}} sgrpg charsheet" autocomplete="off">

<div class="sheet-header">
  <nav class="sheet-navigation tabs" data-group="primary">
    <a class="item active" data-tab="character">Character</a>
    <a class="item" data-tab="background">Background</a>
    <a class="item" data-tab="feats">Feats</a>
    <a class="item" data-tab="inventory">Inventory</a>
    <a class="item" data-tab="configuration">Configuration</a>
  </nav>
</div>

<div class="sg-sheet-body">

<!-- CHARACTER TAB -->
<main class="character tab-content page1 tab" data-tab="character">

  <!-- NAME SECTION -->
  <section class="name columnflex nowrap">
    <!-- Profile Picture - First box -->
    <div class="section profile-img-box">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
    </div>

    <!-- Character Info - Second box -->
    <div class="section name-content">
      <!-- LEFT: Level column -->
      <div class="level-col">
        <input class="level-num" name="system.rank" type="number" placeholder="1" value="{{system.rank}}">
        <span class="level-label">LEVEL</span>
      </div>

      <!-- RIGHT: Name + pills stacked -->
      <div class="name-info-col">
        <input class="char-name-input" name="name" type="text" value="{{actor.name}}" placeholder="Character Name">
        <div class="meta-pills">
          <label class="meta-pill race-pill">
            <input name="system.race" list="race" placeholder="Race" type="text" value="{{system.race}}">
          </label>
          <label class="meta-pill class-pill">
            <select name="system.class">
              <option value="">Class</option>
              {{selectOptions config.classes selected=system.class localize=false}}
            </select>
          </label>
          <button type="button" class="meta-pill td-pill" data-action="rollTD" title="Roll Tension Die">
            <span class="pill-label">TENSION</span>
            <span class="pill-dice">{{system.tensionDie}}</span>
          </button>
          <button type="button" class="meta-pill hd-pill" data-action="rollHD" title="Roll Hit Dice">
            <span class="pill-label">HIT</span>
            <span class="pill-dice">{{system.hd}}</span>
          </button>
          {{#if (eq system.class "scientist")}}
          <label class="meta-pill eureka-pill">
            <span class="pill-label">EUREKA</span>
            <input class="pill-num" name="system.eureka" type="number" placeholder="0" value="{{system.eureka}}">
            <span class="pill-slash">/</span>
            <input class="pill-num" name="system.eureka_max" type="number" value="{{system.eureka_max}}">
          </label>
          {{/if}}
        </div>
      </div>
    </div>

    <!-- DEATH SAVE BOX - Third box -->
    <div class="deathsave-box {{#if (eq system.condition 'death')}}is-dead{{/if}}" data-condition="{{system.condition}}">
      <div class="section death columnflex nowrap center">
        <a type="roll_deathsave" class="txt-btn large" data-action="rollDeathSave">Death Save</a>
        <div class="death-save-checks">
          <div class="rowflex nowrap gap5 aligned">
            <input name="system.death_success1" type="checkbox" {{checked system.death_success1}}>
            <input name="system.death_success2" type="checkbox" {{checked system.death_success2}}>
            <input name="system.death_success3" type="checkbox" {{checked system.death_success3}}>
            <span>Successes</span>
          </div>
          <div class="rowflex nowrap gap5 aligned">
            <input name="system.death_failure1" type="checkbox" {{checked system.death_failure1}}>
            <input name="system.death_failure2" type="checkbox" {{checked system.death_failure2}}>
            <input name="system.death_failure3" type="checkbox" {{checked system.death_failure3}}>
            <span>Failures</span>
          </div>
        </div>
        {{#if (eq system.condition 'death')}}
        <div class="death-overlay">
          <img src="systems/sgrpg/assets/images/death-skull.png" alt="Death" class="death-skull">
        </div>
        {{/if}}
      </div>
    </div>
  </section>

  <!-- ABILITY SCORES (HORIZONTAL BADGES) -->
  <div class="attr rowflex nowrap center">
    {{#each system.attributes as |attr a|}}
      <div class="stat columnflex nowrap center middle" data-attr="{{a}}">
        <a type="roll" class="txt-btn large" data-bonus="system.attributes.{{a}}.mod">{{a}}</a>
        <input data_type="ability_value" name="system.attributes.{{a}}.value" type="number" value="{{attr.value}}">
        <span class="mod">{{attr.modDisplay}}</span>
      </div>
    {{/each}}
  </div>

  <!-- MAIN CONTENT AREA (SKILLS + RIGHT SIDE) -->
  <div class="main-content-area">

    <!-- SKILLS SECTION (LEFT) -->
    <section class="skills columnflex nowrap spaced">
      <h3>Skills</h3>
      {{#each system.skills as |skill s|}}
        <div class="rowflex nowrap" data-skill="{{s}}">
          <input data_type="skill_prof" name="system.skills.{{s}}.proficient" type="checkbox" {{checked skill.proficient}} title="Proficiency">
          <input class="w30" data_type="skill_value" name="system.skills.{{s}}.value" type="text" value="{{skill.value}}">
          <a type="roll" class="txt-btn" data-bonus="system.skills.{{s}}.value">{{lookup @root.config.skills s}}</a>
          <span class="skill-ability-label">({{skill.mod}})</span>
        </div>
      {{/each}}
    </section>

    <!-- RIGHT SIDE (STATS + SAVES + CONDITION + INVENTORY) -->
    <div class="right-side">

      <!-- STATS CONTAINER -->
      <div class="stats-container">
        <div class="stat-box hp-box">
          <div class="stat-icon-wrap"><i class="fas fa-heart"></i></div>
          <div class="stat-content">
            <span class="stat-label">HP</span>
            <div class="stat-row">
              <input class="stat" name="system.health.value" type="number" value="{{system.health.value}}" placeholder="20">
              <span class="slash">/</span>
              <input class="stat" name="system.health.max" type="number" value="{{system.health.max}}" placeholder="20">
            </div>
          </div>
        </div>

        <div class="stat-box temp-hp-box">
          <div class="stat-icon-wrap"><i class="fas fa-heart-pulse"></i></div>
          <div class="stat-content">
            <span class="stat-label">Temp HP</span>
            <div class="stat-row">
              <input class="stat" name="system.temp_health.value" type="number" value="{{system.temp_health.value}}">
              <span class="slash">/</span>
              <input class="stat" name="system.temp_health.max" type="number" value="{{system.temp_health.max}}">
            </div>
          </div>
        </div>

        <div class="stat-box ac-box">
          <div class="stat-icon-wrap"><i class="fas fa-shield-halved"></i></div>
          <div class="stat-content">
            <span class="stat-label">Armor Class</span>
            <input class="stat" name="system.ac" type="number" value="{{system.ac}}">
          </div>
        </div>

        <div class="stat-box speed-box">
          <div class="stat-icon-wrap"><i class="fas fa-person-running"></i></div>
          <div class="stat-content">
            <span class="stat-label">Speed</span>
            <input class="stat" name="system.speed" type="text" value="{{system.speed}}">
          </div>
        </div>

        <div class="stat-box initiative-box">
          <div class="stat-icon-wrap"><i class="fas fa-bolt"></i></div>
          <div class="stat-content">
            <a type="roll_init" class="txt-btn">Initiative</a>
            <input class="stat" name="system.initiative" type="number" value="{{system.initiative}}">
          </div>
        </div>

        <div class="stat-box moxie-box">
          <div class="stat-icon-wrap"><i class="fas fa-fire"></i></div>
          <div class="stat-content">
            <a type="roll_moxie" class="txt-btn">Moxie</a>
            <input class="stat" name="system.moxie" type="number" value="{{system.moxie}}">
          </div>
        </div>

        <div class="stat-box det-box">
          <div class="stat-icon-wrap"><i class="fas fa-circle-dot"></i></div>
          <div class="stat-content">
            <span class="stat-label">Determination</span>
            <div class="stat-row">
              <input class="stat" name="system.determination.value" type="number" value="{{system.determination.value}}">
              <span class="slash">/</span>
              <input class="stat" name="system.determination.max" type="number" value="{{system.determination.max}}">
            </div>
          </div>
        </div>

        <div class="stat-box prof-box">
          <div class="stat-icon-wrap"><i class="fas fa-graduation-cap"></i></div>
          <div class="stat-content">
            <span class="stat-label">Prof Bonus</span>
            <input class="stat" name="system.prof" type="number" value="{{system.prof}}">
          </div>
        </div>
      </div>

      <!-- SAVES, CONDITION, AND INVENTORY CONTAINER -->
      <div class="saves-inventory-container">
        <div class="saves-condition-column">

          <!-- SAVES SECTION -->
          <section class="saves columnflex nowrap">
            <h3>Saves</h3>
            {{#each system.saves as |save s|}}
              <div class="rowflex nowrap" data-save="{{s}}">
                <input data_type="skill_prof" name="system.saves.{{s}}.proficient" type="checkbox" {{checked save.proficient}}>
                <input class="w30" name="system.saves.{{s}}.value" type="text" value="{{save.value}}">
                <a type="roll" class="txt-btn" data-bonus="system.saves.{{s}}.value">{{lookup ../config.saves s}}</a>
              </div>
            {{/each}}
          </section>

          <!-- CONDITION SECTION -->
          <section class="condition columnflex nowrap spaced">
            <h3 class="txtcenter">CONDITION</h3>
            {{radioBoxes "system.condition" config.conditions checked=system.condition localize=false}}
          </section>

        </div>

        <!-- DAMAGE RESISTANCES SECTION -->
        <section class="resistances columnflex nowrap">
          <h4>Damage Resistances</h4>
          <div class="pc-resist-grid">
            <button type="button" class="damage-resistance-btn pc-resist-btn {{system.damageResistances.acid}}" data-damage-type="acid" title="Click to cycle: Normal / Resistant / Vulnerable / Immune">
              <span class="damage-type-name">Acid</span>
            </button>
            <button type="button" class="damage-resistance-btn pc-resist-btn {{system.damageResistances.sonic}}" data-damage-type="sonic" title="Click to cycle: Normal / Resistant / Vulnerable / Immune">
              <span class="damage-type-name">Sonic</span>
            </button>
            <button type="button" class="damage-resistance-btn pc-resist-btn {{system.damageResistances.cold}}" data-damage-type="cold" title="Click to cycle: Normal / Resistant / Vulnerable / Immune">
              <span class="damage-type-name">Cold</span>
            </button>
            <button type="button" class="damage-resistance-btn pc-resist-btn {{system.damageResistances.lightning}}" data-damage-type="lightning" title="Click to cycle: Normal / Resistant / Vulnerable / Immune">
              <span class="damage-type-name">Electricity</span>
            </button>
            <button type="button" class="damage-resistance-btn pc-resist-btn {{system.damageResistances.fire}}" data-damage-type="fire" title="Click to cycle: Normal / Resistant / Vulnerable / Immune">
              <span class="damage-type-name">Fire</span>
            </button>
            <button type="button" class="damage-resistance-btn pc-resist-btn {{system.damageResistances.force}}" data-damage-type="force" title="Click to cycle: Normal / Resistant / Vulnerable / Immune">
              <span class="damage-type-name">Force</span>
            </button>
            <button type="button" class="damage-resistance-btn pc-resist-btn {{system.damageResistances.necrotic}}" data-damage-type="necrotic" title="Click to cycle: Normal / Resistant / Vulnerable / Immune">
              <span class="damage-type-name">Necrotic</span>
            </button>
            <button type="button" class="damage-resistance-btn pc-resist-btn {{system.damageResistances.piercing}}" data-damage-type="piercing" title="Click to cycle: Normal / Resistant / Vulnerable / Immune">
              <span class="damage-type-name">Piercing</span>
            </button>
            <button type="button" class="damage-resistance-btn pc-resist-btn {{system.damageResistances.poison}}" data-damage-type="poison" title="Click to cycle: Normal / Resistant / Vulnerable / Immune">
              <span class="damage-type-name">Poison</span>
            </button>
            <button type="button" class="damage-resistance-btn pc-resist-btn {{system.damageResistances.psychic}}" data-damage-type="psychic" title="Click to cycle: Normal / Resistant / Vulnerable / Immune">
              <span class="damage-type-name">Psychic</span>
            </button>
            <button type="button" class="damage-resistance-btn pc-resist-btn {{system.damageResistances.radiant}}" data-damage-type="radiant" title="Click to cycle: Normal / Resistant / Vulnerable / Immune">
              <span class="damage-type-name">Radiant</span>
            </button>
            <button type="button" class="damage-resistance-btn pc-resist-btn {{system.damageResistances.slashing}}" data-damage-type="slashing" title="Click to cycle: Normal / Resistant / Vulnerable / Immune">
              <span class="damage-type-name">Slashing</span>
            </button>
            <button type="button" class="damage-resistance-btn pc-resist-btn {{system.damageResistances.bludgeoning}}" data-damage-type="bludgeoning" title="Click to cycle: Normal / Resistant / Vulnerable / Immune">
              <span class="damage-type-name">Bludgeoning</span>
            </button>
          </div>
        </section>

      </div>
    </div>
  </div>

  <!-- WEAPONS SECTION -->
  <section class="weapons columnflex nowrap center">
    <h4>Weapons</h4>
    {{> "systems/sgrpg/templates/sheets/parts/actor-weapon-inventory.hbs"}}
  </section>

</main>

<!-- BACKGROUND TAB -->
<main class="background tab-content page2 tab" data-tab="background">

  <!-- PROFICIENCIES SECTION -->
  <section class="proficiencies-section">
    <div class="proficiencies-container">

      <!-- LEFT COLUMN: WEAPON AND ARMOR PROFICIENCIES -->
      <div class="prof-column">
        <!-- WEAPON PROFICIENCIES -->
        <div class="prof-category prof-weapon">
          <h4>Weapon Proficiencies</h4>
          <div class="prof-list">
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.weapon.common" {{checked system.proficiencies.weapon.common}}>
              <span>Common</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.weapon.sidearms" {{checked system.proficiencies.weapon.sidearms}}>
              <span>Sidearms</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.weapon.longarms" {{checked system.proficiencies.weapon.longarms}}>
              <span>Longarms</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.weapon.bows" {{checked system.proficiencies.weapon.bows}}>
              <span>Bows</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.weapon.shotguns" {{checked system.proficiencies.weapon.shotguns}}>
              <span>Shotguns</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.weapon.martialArts" {{checked system.proficiencies.weapon.martialArts}}>
              <span>Martial Arts</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.weapon.jaffa" {{checked system.proficiencies.weapon.jaffa}}>
              <span>Jaffa Weapons</span>
            </label>
          </div>
        </div>

        <!-- ARMOR PROFICIENCIES -->
        <div class="prof-category prof-armor">
          <h4>Armor Proficiencies</h4>
          <div class="prof-list">
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.armor.light" {{checked system.proficiencies.armor.light}}>
              <span>Light Armor</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.armor.heavy" {{checked system.proficiencies.armor.heavy}}>
              <span>Heavy Armor</span>
            </label>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: TOOL PROFICIENCIES -->
      <div class="prof-column">
        <div class="prof-category prof-tool">
          <h4>Tool Proficiencies</h4>
          <div class="prof-list">
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.tool.camoKit" {{checked system.proficiencies.tool.camoKit}}>
              <span>Camo Kit</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.tool.engineeringKit" {{checked system.proficiencies.tool.engineeringKit}}>
              <span>Engineering</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.tool.explosives" {{checked system.proficiencies.tool.explosives}}>
              <span>Explosives</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.tool.fabricationKit" {{checked system.proficiencies.tool.fabricationKit}}>
              <span>Fabrication</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.tool.medKit" {{checked system.proficiencies.tool.medKit}}>
              <span>Med Kit</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.tool.outbreakKit" {{checked system.proficiencies.tool.outbreakKit}}>
              <span>Outbreak Kit</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.tool.panCulturalWardrobe" {{checked system.proficiencies.tool.panCulturalWardrobe}}>
              <span>Wardrobe</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.tool.researchKit" {{checked system.proficiencies.tool.researchKit}}>
              <span>Research Kit</span>
            </label>
            <label class="prof-item">
              <input type="checkbox" name="system.proficiencies.tool.translator" {{checked system.proficiencies.tool.translator}}>
              <span>Translator</span>
            </label>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ORIGIN AND RACE ABILITIES SECTION -->
  <section class="abilities-section origin-abilities-section">
    <h3 class="collapsible-header">Origin and Race Abilities</h3>
    <div class="abilities-grid abilities-grid-collapsible">
      {{#each items.origin as |item|}}
        <div class="ability-card" data-item-id="{{item._id}}">
          <div class="ability-card-header">
            <img src="{{item.img}}" alt="{{item.name}}" />
            <h4>{{item.name}}</h4>
          </div>
          {{#if item.system.castTime.type}}
            <div class="ability-tags-container">
              <span class="ability-tag ability-casttime-bubble casttime-{{item.system.castTime.type}}">
                {{#if item.system.castTime.value}}{{item.system.castTime.value}} {{/if}}{{#if (eq item.system.castTime.type "action")}}Action{{else if (eq item.system.castTime.type "bonus")}}Bonus Action{{else if (eq item.system.castTime.type "reaction")}}Reaction{{else if (eq item.system.castTime.type "turn")}}Turn{{/if}}
              </span>
            </div>
          {{/if}}
          <div class="ability-card-body">
            {{#if item.system.bonus}}
              <p class="ability-bonus">{{{item.system.bonus}}}</p>
            {{/if}}
          </div>
          {{#if item.system.limitations.value}}
            <div class="ability-limitations">
              {{#each (range item.system.limitations.value) as |index|}}
                <input type="checkbox" class="limitation-checkbox" data-item-id="{{../item._id}}" data-index="{{index}}" />
              {{/each}}
              <span class="limitation-label">
                /{{#if (eq item.system.limitations.type "short")}}Short Rest{{else if (eq item.system.limitations.type "long")}}Long Rest{{else if (eq item.system.limitations.type "shortlong")}}Short/Long Rest{{else if (eq item.system.limitations.type "mission")}}Mission{{else if (eq item.system.limitations.type "encounter")}}Encounter{{else if (eq item.system.limitations.type "day")}}Day{{else if (eq item.system.limitations.type "other")}}Other{{/if}}
              </span>
            </div>
          {{/if}}
          <div class="ability-card-footer">
            <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
          </div>
        </div>
      {{else}}
        <p class="empty-message">No origin or race abilities. Drag items here or create new ones.</p>
      {{/each}}
    </div>
  </section>

  <!-- CLASS ABILITIES SECTION -->
  <section class="abilities-section">
    <h3>Class Abilities</h3>
    <div class="abilities-grid">
      {{#each items.classAbility as |item|}}
        <div class="ability-card" data-item-id="{{item._id}}">
          <div class="ability-card-header">
            <img src="{{item.img}}" alt="{{item.name}}" />
            <h4>{{item.name}}</h4>
          </div>
          {{#if (or item.system.level item.system.castTime.type)}}
            <div class="ability-tags-container">
              {{#if item.system.level}}
                <span class="ability-tag ability-level-bubble">
                  {{#if (isNumeric item.system.level)}}LVL: {{/if}}{{item.system.level}}
                </span>
              {{/if}}
              {{#if item.system.castTime.type}}
                <span class="ability-tag ability-casttime-bubble casttime-{{item.system.castTime.type}}">
                  {{#if item.system.castTime.value}}{{item.system.castTime.value}} {{/if}}{{#if (eq item.system.castTime.type "action")}}Action{{else if (eq item.system.castTime.type "bonus")}}Bonus Action{{else if (eq item.system.castTime.type "reaction")}}Reaction{{else if (eq item.system.castTime.type "turn")}}Turn{{/if}}
                </span>
              {{/if}}
            </div>
          {{/if}}
          <div class="ability-card-body">
            {{#if item.system.description.value}}
              <div class="ability-bonus">{{{item.system.description.value}}}</div>
            {{/if}}
          </div>
          {{#if item.system.limitations.value}}
            <div class="ability-limitations">
              {{#each (range item.system.limitations.value) as |index|}}
                <input type="checkbox" class="limitation-checkbox" data-item-id="{{../item._id}}" data-index="{{index}}" />
              {{/each}}
              <span class="limitation-label">
                /{{#if (eq item.system.limitations.type "short")}}Short Rest{{else if (eq item.system.limitations.type "long")}}Long Rest{{else if (eq item.system.limitations.type "shortlong")}}Short/Long Rest{{else if (eq item.system.limitations.type "mission")}}Mission{{else if (eq item.system.limitations.type "encounter")}}Encounter{{else if (eq item.system.limitations.type "day")}}Day{{else if (eq item.system.limitations.type "other")}}Other{{/if}}
              </span>
            </div>
          {{/if}}
          <div class="ability-card-footer">
            <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
          </div>
        </div>
      {{else}}
        <p class="empty-message">No class abilities. Drag items here or create new ones.</p>
      {{/each}}
    </div>
  </section>

</main>

<!-- FEATS TAB -->
<main class="feats tab-content page-feats tab" data-tab="feats">

  <!-- FEATS SECTION -->
  <section class="abilities-section">
    <div class="abilities-grid">
      {{#each items.feat as |item|}}
        <div class="ability-card" data-item-id="{{item._id}}">
          <div class="ability-card-header">
            <img src="{{item.img}}" alt="{{item.name}}" />
            <h4>{{item.name}}</h4>
          </div>
          {{#if (or item.system.category item.system.castTime.type)}}
            <div class="ability-tags-container">
              {{#if item.system.category}}
                <span class="ability-tag ability-level-bubble">
                  {{item.system.category}}
                </span>
              {{/if}}
              {{#if item.system.castTime.type}}
                <span class="ability-tag ability-casttime-bubble casttime-{{item.system.castTime.type}}">
                  {{#if item.system.castTime.value}}{{item.system.castTime.value}} {{/if}}{{#if (eq item.system.castTime.type "action")}}Action{{else if (eq item.system.castTime.type "bonus")}}Bonus Action{{else if (eq item.system.castTime.type "reaction")}}Reaction{{else if (eq item.system.castTime.type "turn")}}Turn{{/if}}
                </span>
              {{/if}}
            </div>
          {{/if}}
          <div class="ability-card-body">
            {{#if item.system.description.value}}
              <div class="ability-bonus">{{{item.system.description.value}}}</div>
            {{/if}}
          </div>
          {{#if item.system.limitations.value}}
            <div class="ability-limitations">
              {{#each (range item.system.limitations.value) as |index|}}
                <input type="checkbox" class="limitation-checkbox" data-item-id="{{../item._id}}" data-index="{{index}}" />
              {{/each}}
              <span class="limitation-label">
                /{{#if (eq item.system.limitations.type "short")}}Short Rest{{else if (eq item.system.limitations.type "long")}}Long Rest{{else if (eq item.system.limitations.type "shortlong")}}Short/Long Rest{{else if (eq item.system.limitations.type "mission")}}Mission{{else if (eq item.system.limitations.type "encounter")}}Encounter{{else if (eq item.system.limitations.type "day")}}Day{{else if (eq item.system.limitations.type "other")}}Other{{/if}}
              </span>
            </div>
          {{/if}}
          <div class="ability-card-footer">
            <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
          </div>
        </div>
      {{else}}
        <p class="empty-message">No feats. Drag items here or create new ones.</p>
      {{/each}}
    </div>
  </section>

</main>

<!-- INVENTORY TAB -->
<main class="inventory-page tab-content page-inventory tab" data-tab="inventory">
  <section class="inventory columnflex nowrap center">
    <div class="inventory-content">
      {{> "systems/sgrpg/templates/sheets/parts/actor-equip-inventory.hbs"}}
    </div>
  </section>
</main>

<!-- CONFIGURATION TAB -->
<main class="configuration tab-content page3 tab" data-tab="configuration">

  <!-- DICE CONFIGURATION -->
  <section class="dice-config columnflex nowrap">
    <h3>Dice Configuration</h3>
    <div class="config-row">
      <div class="config-pair">
      <div class="config-item">
        <label><i class="fas fa-heart-pulse"></i> Status</label>
        <div class="segmented-control">
          <input type="radio" id="status-alive" name="sgStatus" form="sg-status-none" value="alive" {{#unless (eq system.condition "death")}}checked{{/unless}}>
          <label for="status-alive" class="segment-button">Alive</label>

          <input type="radio" id="status-dead" name="sgStatus" form="sg-status-none" value="dead" {{#if (eq system.condition "death")}}checked{{/if}}>
          <label for="status-dead" class="segment-button">Dead</label>
        </div>
      </div>
      <div class="config-item">
        <label><i class="fas fa-user-secret"></i> Whisper Rolls</label>
        <div class="segmented-control">
          <input type="radio" id="whisper-off" name="system.whisperRolls" value="false" data-dtype="Boolean" {{#unless system.whisperRolls}}checked{{/unless}}>
          <label for="whisper-off" class="segment-button">Off</label>

          <input type="radio" id="whisper-on" name="system.whisperRolls" value="true" data-dtype="Boolean" {{#if system.whisperRolls}}checked{{/if}}>
          <label for="whisper-on" class="segment-button" data-tooltip="Rolls are only visible to the GM and the owner">On</label>
        </div>
      </div>
      </div>
      <div class="config-item">
        <label>Hit Dice</label>
        <div class="segmented-control">
          <input type="radio" id="hd-d4" name="system.hd" value="d4" {{#if (eq system.hd "d4")}}checked{{/if}}>
          <label for="hd-d4" class="segment-button"><i class="fas fa-dice-d4"></i> d4</label>

          <input type="radio" id="hd-d6" name="system.hd" value="d6" {{#if (eq system.hd "d6")}}checked{{/if}}>
          <label for="hd-d6" class="segment-button"><i class="fas fa-dice-d6"></i> d6</label>

          <input type="radio" id="hd-d8" name="system.hd" value="d8" {{#if (eq system.hd "d8")}}checked{{/if}}>
          <label for="hd-d8" class="segment-button"><i class="fas fa-dice-d8"></i> d8</label>

          <input type="radio" id="hd-d10" name="system.hd" value="d10" {{#if (eq system.hd "d10")}}checked{{/if}}>
          <label for="hd-d10" class="segment-button"><i class="fas fa-dice-d10"></i> d10</label>

          <input type="radio" id="hd-d12" name="system.hd" value="d12" {{#if (eq system.hd "d12")}}checked{{/if}}>
          <label for="hd-d12" class="segment-button"><i class="fas fa-dice-d12"></i> d12</label>
        </div>
      </div>
      <div class="config-item">
        <label>Initiative Roll Mode</label>
        <div class="segmented-control">
          <input type="radio" id="init-disadvantage" name="system.initiativeMode" value="disadvantage" {{#if (eq system.initiativeMode "disadvantage")}}checked{{/if}}>
          <label for="init-disadvantage" class="segment-button">Disadvantage</label>

          <input type="radio" id="init-normal" name="system.initiativeMode" value="normal" {{#if (or (eq system.initiativeMode "normal") (not system.initiativeMode))}}checked{{/if}}>
          <label for="init-normal" class="segment-button">Normal</label>

          <input type="radio" id="init-advantage" name="system.initiativeMode" value="advantage" {{#if (eq system.initiativeMode "advantage")}}checked{{/if}}>
          <label for="init-advantage" class="segment-button">Advantage</label>
        </div>
      </div>
      <div class="config-item">
        <label>Moxie Roll Mode</label>
        <div class="segmented-control">
          <input type="radio" id="moxie-disadvantage" name="system.moxieMode" value="disadvantage" {{#if (eq system.moxieMode "disadvantage")}}checked{{/if}}>
          <label for="moxie-disadvantage" class="segment-button">Disadvantage</label>

          <input type="radio" id="moxie-normal" name="system.moxieMode" value="normal" {{#if (or (eq system.moxieMode "normal") (not system.moxieMode))}}checked{{/if}}>
          <label for="moxie-normal" class="segment-button">Normal</label>

          <input type="radio" id="moxie-advantage" name="system.moxieMode" value="advantage" {{#if (eq system.moxieMode "advantage")}}checked{{/if}}>
          <label for="moxie-advantage" class="segment-button">Advantage</label>
        </div>
      </div>
      <div class="config-item">
        <label><i class="fas fa-weight-hanging"></i> Bulk Limit</label>
        <input name="system.bulk" type="number" value="{{system.bulk}}" style="width:60px; text-align:center;">
      </div>
    </div>

    <!-- SKILL ATTRIBUTE CONFIGURATION -->
    <h4>Skill Attribute Configuration</h4>
    <p>Configure which attribute modifier each skill uses. Defaults are set automatically, but you can override them here.</p>

    <div class="skill-config-grid">
      {{#each system.skills as |skill s|}}
        <div class="skill-config-row rowflex nowrap" data-skill="{{s}}">
          <label class="skill-name">{{s}}</label>
          <select data_type="skill_mod" name="system.skills.{{s}}.mod" class="skillModSelect">
            {{selectOptions ../config.abilities selected=skill.mod localize=false}}
          </select>
          <a class="skill-mod-revert" title="Revert to default attribute mod"><i class="fa fa-undo"></i></a>
        </div>
      {{/each}}
    </div>
  </section>

  <!-- MISSION PREP RATING -->
  <section class="prep-rating-config columnflex nowrap">
    <h3>Mission Prep Rating</h3>
    <p class="section-description">Select the mission preparation level to view available equipment kits.</p>
    <div class="config-row">
      <div class="config-item">
        <label>Prep Rating</label>
        <select name="system.prepRating" class="prep-rating-select">
          {{selectOptions config.prepRatings selected=system.prepRating localize=false}}
        </select>
      </div>
    </div>

    <!-- KIT DISPLAY -->
    <div class="kit-display">
      <h4>Equipment Kit Contents</h4>

      {{#if (eq system.prepRating "0")}}
      <div class="kit-section">
        <h5>0-Prep Mission</h5>
        <p><strong>Equipment:</strong> None - civilian clothes or unarmored uniform only</p>
      </div>
      {{/if}}

      {{#if (eq system.prepRating "1")}}
      <div class="kit-section">
        <h5>1-Prep Mission (Base Kit)</h5>
        <div class="kit-items">
          <h6>Individual Base Kit:</h6>
          <ul>
            <li>Tactical Vest & 3 Uniforms</li>
            <li>MREs (mission duration)</li>
            <li>Combat Knife (Shortblade, Tech Level 2)</li>
            <li>Personal Tactical Radio</li>
            <li>Flashlight</li>
            <li>Water Purifier</li>
            <li>Filtration/Radiation Mask</li>
            <li>Multi-tool</li>
            <li>Personal Medical Kit</li>
            <li>Extended Climate Protection Clothing</li>
            <li>Combat Tent</li>
            <li>Sidearm with two magazines</li>
            <li>Longarm with two magazines</li>
          </ul>
          <h6>Team Equipment:</h6>
          <ul>
            <li>1x G.D.O. (Garage Door Opener - bulk 1)</li>
          </ul>
        </div>
      </div>
      {{/if}}

      {{#if (eq system.prepRating "2")}}
      <div class="kit-section">
        <h5>2-Prep Mission (Phoenix Gate Camp Kit)</h5>
        <details class="base-kit-toggle">
          <summary><em>Includes all Individual Base Kit items (click to expand)</em></summary>
          <ul class="base-kit-list">
            <li>Tactical Vest & 3 Uniforms</li>
            <li>MREs (mission duration)</li>
            <li>Combat Knife (Shortblade, Tech Level 2)</li>
            <li>Personal Tactical Radio</li>
            <li>Flashlight</li>
            <li>Water Purifier</li>
            <li>Filtration/Radiation Mask</li>
            <li>Multi-tool</li>
            <li>Personal Medical Kit</li>
            <li>Extended Climate Protection Clothing</li>
            <li>Combat Tent</li>
            <li>Sidearm with two magazines</li>
            <li>Longarm with two magazines</li>
            <li>1x G.D.O. (Team Equipment)</li>
          </ul>
        </details>
        <div class="kit-items">
          <h6>Team Kit:</h6>
          <ul>
            <li><strong>Weapons:</strong> 3x spare FN P90s, 6x spare Beretta M9s, 10,000 rounds sidearm ammo, 10,000 rounds longarm ammo</li>
            <li><strong>Supplies:</strong> General supplies to refill each team member's base kit 3 times, 3 months MREs per team member</li>
            <li><strong>Medical:</strong> 3x Medical Kits</li>
            <li><strong>Shelter:</strong> 3x additional combat tents, 3x additional multi-tools, Inflatable Boat</li>
            <li><strong>Construction:</strong> 5km nylon rope, service & repair tools, 5x 35kg bags of Concrete</li>
            <li><strong>Power:</strong> 3x Generators w/3 months fuel, Solar Recharging Station, replacement electronics</li>
          </ul>
          <p><strong>Setup Time:</strong> 4-5 people, approximately 1 hour</p>
        </div>
      </div>
      {{/if}}

      {{#if (eq system.prepRating "3")}}
      <div class="kit-section">
        <h5>3-Prep Mission (Extended Camp Kit)</h5>
        <details class="base-kit-toggle">
          <summary><em>Includes all Individual Base Kit items (click to expand)</em></summary>
          <ul class="base-kit-list">
            <li>Tactical Vest & 3 Uniforms</li>
            <li>MREs (mission duration)</li>
            <li>Combat Knife (Shortblade, Tech Level 2)</li>
            <li>Personal Tactical Radio</li>
            <li>Flashlight</li>
            <li>Water Purifier</li>
            <li>Filtration/Radiation Mask</li>
            <li>Multi-tool</li>
            <li>Personal Medical Kit</li>
            <li>Extended Climate Protection Clothing</li>
            <li>Combat Tent</li>
            <li>Sidearm with two magazines</li>
            <li>Longarm with two magazines</li>
            <li>1x G.D.O. (Team Equipment)</li>
          </ul>
        </details>
        <div class="kit-items">
          <h6>Team Kit:</h6>
          <ul>
            <li><strong>Weapons:</strong> 50,000 rounds sidearm ammo, 50,000 rounds longarm ammo</li>
            <li><strong>Supplies:</strong> General supplies to refill each team member's base kit 12 times, 6 months MREs per team member</li>
            <li><strong>Medical:</strong> Medical Tent (fully stocked)</li>
            <li><strong>Shelter:</strong> 6x additional combat tents, 3x additional multi-tools, Inflatable Boat</li>
            <li><strong>Construction:</strong> 5km nylon ropeline, service & repair tools, 10x 35kg bags of Concrete</li>
            <li><strong>Power:</strong> 3x Generators w/6 months fuel, Solar Recharging Station, tactical radio relay, replacement electronics</li>
            <li><strong>Vehicles:</strong> 1x ATV per team member, 2x spare ATVs</li>
          </ul>
          <p><strong>Setup Time:</strong> 4-5 people, 2 hours</p>
          <p><strong>Special:</strong> Repairs do NOT suffer disadvantage at this camp</p>
        </div>
      </div>
      {{/if}}

      {{#if (eq system.prepRating "4")}}
      <div class="kit-section">
        <h5>4-Prep Mission (Frontline Kit)</h5>
        <details class="base-kit-toggle">
          <summary><em>Includes all Individual Base Kit items (click to expand)</em></summary>
          <ul class="base-kit-list">
            <li>Tactical Vest & 3 Uniforms</li>
            <li>MREs (mission duration)</li>
            <li>Combat Knife (Shortblade, Tech Level 2)</li>
            <li>Personal Tactical Radio</li>
            <li>Flashlight</li>
            <li>Water Purifier</li>
            <li>Filtration/Radiation Mask</li>
            <li>Multi-tool</li>
            <li>Personal Medical Kit</li>
            <li>Extended Climate Protection Clothing</li>
            <li>Combat Tent</li>
            <li>Sidearm with two magazines</li>
            <li>Longarm with two magazines</li>
            <li>1x G.D.O. (Team Equipment)</li>
          </ul>
        </details>
        <div class="kit-items">
          <h6>Forward Base Structure:</h6>
          <ul>
            <li>200m square wall perimeter</li>
            <li>5 Guard Towers</li>
            <li>8 inner buildings (2x Barracks, Officer's tent, Mess hall, Latrine/showers, Armory, 2x Additional buildings)</li>
            <li>Capacity: 50-100 Phoenix Site personnel</li>
          </ul>
          <h6>Equipment:</h6>
          <ul>
            <li>3x Extended Camp Kits' worth of supplies</li>
            <li>Fabrication and repair facilities</li>
          </ul>
          <p><strong>Construction Time:</strong> Under 24 hours</p>
          <p><strong>Special:</strong> ADVANTAGE on repair checks, new items manufactured WITHOUT DISADVANTAGE</p>
        </div>
      </div>
      {{/if}}

      <!-- CLASS-SPECIFIC KIT -->
      {{#if (and system.class (not (eq system.prepRating "0")))}}
      <div class="kit-section class-kit">
        <h5>Class-Specific Equipment</h5>
        <p><strong>Your Class:</strong> {{lookup config.classes system.class}}</p>
        <div class="kit-items">
          {{#if (eq system.class "engineer")}}
          <ul>
            <li><strong>Engineering Kit</strong> - For field repairs, used with Jury Rig ability</li>
          </ul>
          {{/if}}
          {{#if (eq system.class "scout")}}
          <ul>
            <li><strong>Camo Kit</strong> - For stealth operations, used with Field Hacks abilities</li>
          </ul>
          {{/if}}
          {{#if (eq system.class "diplomat")}}
          <ul>
            <li><strong>Translator</strong> - Handheld language device with library of every catalogued Phoenix Site language</li>
          </ul>
          {{/if}}
          {{#if (eq system.class "medic")}}
          <ul>
            <li><strong>Med Kit</strong> - Enhanced medical supplies, used with First Aid and Procedures abilities</li>
          </ul>
          {{/if}}
          {{#if (eq system.class "soldier")}}
          <p><em>No additional class-specific equipment</em></p>
          {{/if}}
          {{#if (eq system.class "scientist")}}
          <p><em>No additional class-specific equipment</em></p>
          {{/if}}
        </div>
      </div>
      {{/if}}
    </div>
  </section>

  <!-- PORTRAIT & TOKEN -->
  <section class="portrait-token-config columnflex nowrap">
    <h3>Portrait &amp; Token</h3>
    <p class="section-description">Click an image to choose a new one.</p>
    <div class="pt-row">
      <div class="pt-item">
        <label>Portrait</label>
        <img class="pt-image pt-portrait" src="{{actor.img}}" data-field="img" data-tooltip="Click to change the portrait" alt="Portrait"/>
      </div>
      <div class="pt-item">
        <label>Token</label>
        <img class="pt-image pt-token" src="{{actor.prototypeToken.texture.src}}" data-field="prototypeToken.texture.src" data-tooltip="Click to change the token image" alt="Token"/>
      </div>
    </div>
  </section>

</main>

</div>
</form>
