    },
    {
      "_id": "4160da9c49775338",
      "name": "Uncanny Dodge",
      "type": "feat",
      "img": "systems/sgrpg/assets/compendium/feats/uncanny-dodge.webp",
      "system": {
        "mpCost": "5",
        "requirement": "Dexterity 13+",
        "category": "Combat - General",
        "castTime": {
          "value": "",
          "type": "reaction"
        },
        "limitations": {
          "value": "",
          "type": ""
        },
        "description": {
          "value": "<p>When an attacker that you can see hits you with an attack, you can use your reaction to gain resistance to the damage. This ability does not function against attacks that deal damage in an area or cone (but it does work against line effects).</p>"
        }
      },
