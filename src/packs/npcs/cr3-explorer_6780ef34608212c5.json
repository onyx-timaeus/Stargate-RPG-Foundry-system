      "name": "Uncanny Dodge",
      "type": "feat",
      "img": "systems/sgrpg/assets/compendium/feats/uncanny-dodge.webp",
      "system": {
        "mpCost": "5",
        "requirement": "Dexterity 13+",
        "category": "Combat - General",
        "castTime": {
          "value": "",
          "type": "reaction"
        },
        "limitations": {
          "value": "",
          "type": ""
        },
        "description": {
