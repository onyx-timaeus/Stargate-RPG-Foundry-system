    {
      "_id": "8252316556bbe242",
      "name": "Vanguard (1d6)",
      "type": "feat",
      "img": "systems/sgrpg/assets/compendium/feats/vanguard.webp",
      "system": {
        "mpCost": "5",
        "requirement": "Stealth and Survival",
        "category": "Combat - Ranged",
        "castTime": {
